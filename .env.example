# Txlemetry API Configuration
# Copy this file to .env and update with your actual values

# Your project API key (found on the /setup page in Txlemetry)
TXLEMETRY_PROJECT_API_KEY=phc_your_project_api_key_here

# Your secret API key (for local evaluation and other advanced features)
TXLEMETRY_SECRET_KEY=phx_your_secret_api_key_here

# Txlemetry host URL (remove this line if using app.txlemetry.com)
TXLEMETRY_HOST=https://app.txlemetry.com
